<!DOCTYPE html>
<html lang="vi">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>Tiệm Kem Hồng - Game Bán Kem</title>
 <style>
 :root{
 --pink-1:#ffd1e8;
 --pink-2:#ff9fcb;
 --pink-3:#ff6fae;
 --pink-4:#ff4f9a;
 --bg:#fff4fa;
 --text:#5b2943;
 --card:#ffffff;
 --shadow: 0 10px 30px rgba(255,111,174,.18);
 --radius: 22px;
 }
 *{box-sizing:border-box}
 body{
 margin:0;
 font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
 background: linear-gradient(180deg, #fff0f7 0%, #ffe3f0 100%);
 color:var(--text);
 min-height:100vh;
 }
 header{
 padding:24px 16px 10px;
 text-align:center;
 }
 h1{
 margin:0;
 font-size: clamp(28px, 4vw, 44px);
 color: var(--pink-4);
 text-shadow: 0 2px 0 rgba(255,255,255,.8);
 }
 .subtitle{
 margin-top:8px;
 opacity:.9;
 font-size:15px;
 }
 .container{
 width:min(1100px, 94vw);
 margin: 16px auto 40px;
 display:grid;
 grid-template-columns: 1.1fr .9fr;
 gap:18px;
 }
 .card{
 background: rgba(255,255,255,.92);
 border: 1px solid rgba(255,111,174,.15);
 border-radius: var(--radius);
 box-shadow: var(--shadow);
 padding:18px;
 backdrop-filter: blur(8px);
 }
 .section-title{
 margin:0 0 12px;
 font-size:20px;
 color:#d9468f;
 }
 .menu-grid{
 display:grid;
 grid-template-columns: repeat(2, minmax(0,1fr));
 gap:12px;
 }
 .option{
 border:2px solid #ffd0e4;
 background:#fff7fb;
 border-radius:18px;
 padding:12px;
 cursor:pointer;
 transition:.2s ease;
 text-align:left;
 display:flex;
 gap:12px;
 align-items:center;
 }
 .option:hover{ transform: translateY(-2px); border-color: #ff8fc1; }
 .option.selected{
 background: linear-gradient(180deg, #ffe1ee, #fff);
 border-color: var(--pink-4);
 box-shadow: 0 8px 18px rgba(255,111,174,.18);
 }
 .emoji{
 font-size:34px;
 width:46px; height:46px;
 display:flex; align-items:center; justify-content:center;
 background:#fff;
 border-radius:14px;
 box-shadow: inset 0 0 0 2px #ffe0ec;
 flex:0 0 auto;
 }
 .label{ font-weight:700; }
 .small{ font-size:13px; opacity:.8; margin-top:2px; }
 .row{
 display:flex;
 gap:12px;
 flex-wrap:wrap;
 }
 .pill{
 border:none;
 background: linear-gradient(180deg, var(--pink-2), var(--pink-3));
 color:white;
 padding:12px 16px;
 border-radius:999px;
 font-weight:700;
 cursor:pointer;
 box-shadow: 0 8px 18px rgba(255,111,174,.25);
 transition:.2s ease;
 }
 .pill:hover{ transform: translateY(-1px); }
 .pill.secondary{
 background:#fff;
 color:var(--pink-4);
 border:2px solid #ffb6d7;
 box-shadow:none;
 }
 .preview{
 display:flex;
 align-items:center;
 justify-content:center;
 min-height: 360px;
 position:relative;
 overflow:hidden;
 }
 .cone-wrap{
 width:260px;
 height:320px;
 position:relative;
 display:flex;
 align-items:flex-end;
 justify-content:center;
 }
 .scoop{
 position:absolute;
 width:120px;
 height:120px;
 border-radius:50%;
 top: 28px;
 box-shadow: inset -8px -10px 0 rgba(0,0,0,.06);
 border: 5px solid rgba(255,255,255,.7);
 }
 .scoop:nth-child(1){ left:34px; background:#ffb3d9; }
 .scoop:nth-child(2){ left:80px; background:#ffc9a8; top:8px; }
 .scoop:nth-child(3){ left:124px; background:#f6f08d; }
 .drip{
 position:absolute;
 width:42px; height:42px;
 background:inherit;
 border-radius:0 0 50% 50%;
 bottom:-18px;
 left:36px;
 filter: brightness(.98);
 }
 .cone{
 width:150px;
 height:180px;
 background: linear-gradient(180deg, #f2c28f, #cf8e4d);
 clip-path: polygon(50% 100%, 0 0, 100% 0);
 border-radius: 0 0 18px 18px;
 position:absolute;
 bottom:0;
 box-shadow: inset 0 -10px 0 rgba(0,0,0,.06);
 }
 .topping{
 position:absolute;
 font-size:24px;
 animation: float 2.2s ease-in-out infinite;
 }
 @keyframes float{
 0%,100%{ transform: translateY(0); }
 50%{ transform: translateY(-6px); }
 }
 .info{
 display:grid;
 gap:10px;
 }
 .box{
 background:#fff8fc;
 border:1px solid #ffd1e8;
 border-radius:18px;
 padding:14px;
 }
 .price{
 font-size:28px;
 font-weight:800;
 color:#d61f78;
 }
 .customer{
 font-size:16px;
 line-height:1.5;
 }
 .receipt{
 font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
 background:#fff;
 border:1px dashed #f0a6c8;
 border-radius:14px;
 padding:12px;
 white-space:pre-wrap;
 min-height:120px;
 }
 .score{
 display:flex;
 justify-content:space-between;
 gap:10px;
 flex-wrap:wrap;
 font-weight:700;
 }
 .badge{
 background:#ffe0ef;
 padding:8px 12px;
 border-radius:999px;
 color:#b11966;
 }
 footer{
 text-align:center;
 padding: 0 16px 24px;
 color:#8c4b6d;
 font-size:14px;
 }
 @media (max-width: 900px){
 .container{ grid-template-columns: 1fr; }
 .preview{ min-height:320px; }
 }
 @media (max-width: 520px){
 .menu-grid{ grid-template-columns: 1fr; }
 .cone-wrap{ transform: scale(.9); }
 }
 </style>
</head>
<body>
 <header>
 <h1>🍦 Tiệm Kem Hồng</h1>
 <div class="subtitle">Chọn kem, thêm topping và bán cho khách để kiếm điểm!</div>
 </header>

 <main class="container">
 <section class="card">
 <h2 class="section-title">Chọn nguyên liệu</h2>

 <div class="box" style="margin-bottom:12px;">
 <strong>1. Chọn vị kem</strong>
 <div class="menu-grid" id="scoopMenu" style="margin-top:10px;"></div>
 </div>

 <div class="box" style="margin-bottom:12px;">
 <strong>2. Chọn topping</strong>
 <div class="menu-grid" id="toppingMenu" style="margin-top:10px;"></div>
 </div>

 <div class="box" style="margin-bottom:12px;">
 <strong>3. Chọn kiểu đựng</strong>
 <div class="row" style="margin-top:10px;">
 <button class="pill secondary" data-container="cone">Ốc quế</button>
 <button class="pill secondary" data-container="cup">Cốc</button>
 </div>
 </div>

 <div class="row">
 <button class="pill" id="sellBtn">Bán kem</button>
 <button class="pill secondary" id="newOrderBtn">Đơn mới</button>
 </div>
 </section>

 <section class="card">
 <h2 class="section-title">Xem trước đơn kem</h2>
 <div class="preview box">
 <div class="cone-wrap" id="previewArea">
 <div class="cone" id="containerShape"></div>
 </div>
 </div>

 <div class="info" style="margin-top:12px;">
 <div class="box">
 <div class="score">
 <div>Điểm: <span id="score">0</span></div>
 <div>Tiền: <span id="money">0</span>₫</div>
 </div>
 </div>

 <div class="box">
 <div><strong>Khách hàng:</strong></div>
 <div class="customer" id="customerText"></div>
 </div>

 <div class="box">
 <div><strong>Hóa đơn:</strong></div>
 <div class="receipt" id="receiptText"></div>
 </div>
 </div>
 </section>
 </main>

 <footer>
 Phiên bản demo màu hồng dễ thương cho game bán kem.
 </footer>

 <script>
 const scoops = [
 { id: "strawberry", name: "Dâu", emoji: "🍓", price: 12000, color: "#ff8fc1" },
 { id: "vanilla", name: "Vani", emoji: "🍨", price: 10000, color: "#ffe8b6" },
 { id: "choco", name: "Socola", emoji: "🍫", price: 13000, color: "#c98b5b" },
 { id: "mint", name: "Bạc hà", emoji: "🧁", price: 14000, color: "#a8f0d0" }
 ];

 const toppings = [
 { id: "sprinkles", name: "Rắc đường", emoji: "✨", price: 2000 },
 { id: "cherry", name: "Cherry", emoji: "🍒", price: 3000 },
 { id: "cookie", name: "Bánh quy", emoji: "🍪", price: 4000 },
 { id: "heart", name: "Trái tim", emoji: "💖", price: 2500 }
 ];

 const customers = [
 "Khách muốn kem dâu + cherry, đựng trong ốc quế.",
 "Khách thích kem vani + rắc đường, đựng trong cốc.",
 "Khách gọi kem socola + bánh quy, thật nhiều topping!",
 "Khách muốn món ngọt dễ thương nhất quán."
 ];

 let state = {
 scoop: scoops[0],
 topping: toppings[0],
 container: "cone",
 score: 0,
 money: 0
 };

 const scoopMenu = document.getElementById("scoopMenu");
 const toppingMenu = document.getElementById("toppingMenu");
 const previewArea = document.getElementById("previewArea");
 const containerShape = document.getElementById("containerShape");
 const customerText = document.getElementById("customerText");
 const receiptText = document.getElementById("receiptText");
 const scoreEl = document.getElementById("score");
 const moneyEl = document.getElementById("money");

 function renderMenus(){
 scoopMenu.innerHTML = scoops.map(s => `
 <button class="option ${state.scoop.id === s.id ? "selected" : ""}" data-scoop="${s.id}">
 <div class="emoji">${s.emoji}</div>
 <div>
 <div class="label">${s.name}</div>
 <div class="small">${s.price.toLocaleString("vi-VN")}₫</div>
 </div>
 </button>
 `).join("");

 toppingMenu.innerHTML = toppings.map(t => `
 <button class="option ${state.topping.id === t.id ? "selected" : ""}" data-topping="${t.id}">
 <div class="emoji">${t.emoji}</div>
 <div>
 <div class="label">${t.name}</div>
 <div class="small">${t.price.toLocaleString("vi-VN")}₫</div>
 </div>
 </button>
 `).join("");

 document.querySelectorAll("[data-container]").forEach(btn => {
 btn.classList.toggle("selected", btn.dataset.container === state.container);
 });
 }

 function renderPreview(){
 previewArea.querySelectorAll(".scoop, .topping").forEach(el => el.remove());

 if(state.container === "cone"){
 containerShape.className = "cone";
 } else {
 containerShape.className = "";
 containerShape.style.width = "150px";
 containerShape.style.height = "170px";
 containerShape.style.borderRadius = "18px 18px 28px 28px";
 containerShape.style.background = "linear-gradient(180deg, #ffe2f1, #ffbad9)";
 containerShape.style.clipPath = "none";
 containerShape.style.bottom = "6px";
 containerShape.innerHTML = "";
 }

 const scoop = document.createElement("div");
 scoop.className = "scoop";
 scoop.style.background = state.scoop.color;
 scoop.style.left = "70px";
 scoop.style.top = "34px";
 previewArea.appendChild(scoop);

 const drip = document.createElement("div");
 drip.className = "drip";
 drip.style.background = state.scoop.color;
 scoop.appendChild(drip);

 const top = document.createElement("div");
 top.className = "topping";
 top.textContent = state.topping.emoji;
 top.style.left = "118px";
 top.style.top = "10px";
 previewArea.appendChild(top);

 if(state.container === "cup"){
 const cupStripe = document.createElement("div");
 cupStripe.style.position = "absolute";
 cupStripe.style.width = "90px";
 cupStripe.style.height = "14px";
 cupStripe.style.background = "rgba(255,255,255,.35)";
 cupStripe.style.borderRadius = "999px";
 cupStripe.style.left = "85px";
 cupStripe.style.bottom = "72px";
 previewArea.appendChild(cupStripe);
 }
 }

 function renderInfo(){
 customerText.textContent = customers[Math.floor(Math.random() * customers.length)];
 const total = state.scoop.price + state.topping.price + (state.container === "cup" ? 1000 : 0);
 receiptText.textContent =
`ĐƠN HÀNG
- Vị kem: ${state.scoop.name}
- Topping: ${state.topping.name}
- Kiểu đựng: ${state.container === "cone" ? "Ốc quế" : "Cốc"}
- Tổng tiền: ${total.toLocaleString("vi-VN")}₫

Hãy nhấn "Bán kem" để hoàn tất!`;
 }

 function renderScore(){
 scoreEl.textContent = state.score;
 moneyEl.textContent = state.money.toLocaleString("vi-VN");
 }

 function updateAll(){
 renderMenus();
 renderPreview();
 renderInfo();
 renderScore();
 }

 scoopMenu.addEventListener("click", (e) => {
 const btn = e.target.closest("[data-scoop]");
 if(!btn) return;
 state.scoop = scoops.find(s => s.id === btn.dataset.scoop);
 updateAll();
 });

 toppingMenu.addEventListener("click", (e) => {
 const btn = e.target.closest("[data-topping]");
 if(!btn) return;
 state.topping = toppings.find(t => t.id === btn.dataset.topping);
 updateAll();
 });

 document.querySelectorAll("[data-container]").forEach(btn => {
 btn.addEventListener("click", () => {
 state.container = btn.dataset.container;
 updateAll();
 });
 });

 document.getElementById("sellBtn").addEventListener("click", () => {
 const total = state.scoop.price + state.topping.price + (state.container === "cup" ? 1000 : 0);
 state.score += 10;
 state.money += total;
 receiptText.textContent =
`ĐÃ BÁN THÀNH CÔNG! 🎉
Bạn vừa bán:
- ${state.scoop.name}
- ${state.topping.name}
- ${state.container === "cone" ? "Ốc quế" : "Cốc"}

+${total.toLocaleString("vi-VN")}₫`;
 renderScore();
 setTimeout(renderInfo, 900);
 });

 document.getElementById("newOrderBtn").addEventListener("click", () => {
 state.scoop = scoops[Math.floor(Math.random() * scoops.length)];
 state.topping = toppings[Math.floor(Math.random() * toppings.length)];
 state.container = Math.random() > 0.5 ? "cone" : "cup";
 updateAll();
 });

 updateAll();
 </script>
</body>
</html>
